# Copy to .env.local for local development. Never commit .env.local.
#
# Both values come from your Supabase project:
#   Dashboard → Project Settings → API
#
# The anon key is a PUBLIC key. It is compiled into the JavaScript bundle and
# every visitor can read it. That is fine and by design — access is controlled
# by row level security in supabase/schema.sql, not by hiding this key.
#
# NEVER put the service_role key here or anywhere in this repo. It bypasses
# every security policy.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
